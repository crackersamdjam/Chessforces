{
	"name": "chessforces",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "npm run build && node dist/server.js",
		"build": "tsc -p tsconfig.json && mkdir -p dist/public && cp public/index.html public/styles.css public/favicon.svg dist/public/",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint .",
		"test": "node --loader ts-node/esm --test test/unit/*.test.ts",
		"test:playthrough": "LOG_PLAYTHROUGH=1 node --loader ts-node/esm --test test/unit/playthrough.test.ts",
		"test:smoke": "node --loader ts-node/esm test/smoke/lobby_round_and_chat.ts && node --loader ts-node/esm test/smoke/turn_timer_skip.ts && node --loader ts-node/esm test/smoke/forfeit_and_draw_actions.ts && node --loader ts-node/esm test/smoke/download_game_end_states.ts && node --loader ts-node/esm test/smoke/playthrough_game.ts && node --loader ts-node/esm test/smoke/reconnect.ts",
		"test:smoke:lobby": "node --loader ts-node/esm test/smoke/lobby_round_and_chat.ts",
		"test:smoke:turn-timer": "node --loader ts-node/esm test/smoke/turn_timer_skip.ts",
		"test:smoke:forfeit-draw": "node --loader ts-node/esm test/smoke/forfeit_and_draw_actions.ts",
		"test:smoke:download": "node --loader ts-node/esm test/smoke/download_game_end_states.ts",
		"test:smoke:playthrough": "node --loader ts-node/esm test/smoke/playthrough_game.ts",
		"test:smoke:reconnect": "node --loader ts-node/esm test/smoke/reconnect.ts",
		"test:e2e": "npm run test:smoke",
		"test:e2e:lobby": "npm run test:smoke:lobby",
		"test:e2e:turn-timer": "npm run test:smoke:turn-timer",
		"test:e2e:forfeit-draw": "npm run test:smoke:forfeit-draw",
		"test:e2e:download": "npm run test:smoke:download",
		"test:e2e:playthrough": "npm run test:smoke:playthrough",
		"test:e2e:reconnect": "npm run test:smoke:reconnect"
	},
	"dependencies": {
		"express": "^5.2.1",
		"nanoid": "^5.1.11",
		"ws": "^8.21.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/express": "^5.0.6",
		"@types/node": "^25.9.1",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"eslint": "^10.4.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	}
}
